<?xml version="1.0" encoding="utf-8"?>
<!-- Login ekranı — üst açık lavanta + alt koyu kart + içbükey yay geçiş -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_gradient">

    <!-- Üst alan: ikon + başlık -->
    <LinearLayout
        android:id="@+id/layoutTop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layoutBottom"
        app:layout_constraintVertical_weight="1">

        <!-- Logo -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/journal"
            android:layout_marginBottom="10dp"
            android:scaleType="fitCenter" />

        <!-- Uygulama adı -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#A78BFA"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Slogan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_tagline"
            android:textColor="#A78BFA"
            android:fontFamily="@font/thondpachem_regular"
            android:textSize="14sp"
            android:alpha="0.85"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- Alt koyu kart -->
    <ScrollView
        android:id="@+id/layoutBottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/auth_bottom_bg"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/layoutTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_weight="1.4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- Alt başlık -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nasıl devam etmek istersin?"
                android:textColor="@color/auth_text_hint"
                android:fontFamily="@font/thondpachem_regular"
                android:textSize="14sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="28dp" />

            <!-- Google ile Giriş Yap -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoginGoogle"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Google ile Giriş Yap"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/auth_btn_secondary"
                app:cornerRadius="50dp"
                app:icon="@drawable/ic_google"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@null" />

            <!-- E-posta ile Giriş Yap -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoginEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="E-posta ile Giriş Yap"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/auth_btn_primary"
                app:cornerRadius="50dp"
                app:icon="@drawable/ic_mail"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@color/white" />

            <!-- E-posta formu — başlangıçta gizli -->
            <LinearLayout
                android:id="@+id/layoutEmailForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilLoginEmail"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="@string/login_hint_email"
                    android:textColorHint="@color/auth_text_hint"
                    app:boxStrokeColor="@color/auth_btn_primary"
                    app:hintTextColor="@color/auth_text_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLoginEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:autofillHints="emailAddress"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilLoginPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="@string/login_hint_password"
                    android:textColorHint="@color/auth_text_hint"
                    app:boxStrokeColor="@color/auth_btn_primary"
                    app:hintTextColor="@color/auth_text_hint"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/white">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLoginPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:autofillHints="password"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <CheckBox
                    android:id="@+id/cbRememberMe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_remember_me"
                    android:textColor="@color/auth_text_hint"
                    android:layout_marginBottom="20dp" />

                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_btn_auth_primary"
                    android:text="@string/login_btn"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <ProgressBar
                    android:id="@+id/progressLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Kayıt ol linki -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_no_account"
                    android:textColor="@color/auth_text_hint"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvGoToRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_register_link"
                    android:textColor="@color/auth_btn_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- İçbükey yay efekti: ekran genişliğinde, alt kartın rengiyle aynı -->
    <ImageView
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:src="@drawable/ellipse"
        android:scaleType="fitXY"
        app:tint="@color/auth_bottom_bg"
        app:layout_constraintBottom_toTopOf="@id/layoutBottom"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTop" />

</androidx.constraintlayout.widget.ConstraintLayout>
