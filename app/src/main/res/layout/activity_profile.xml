<?xml version="1.0" encoding="utf-8"?>
<!-- Profil ekranı — login/register/main ile aynı renk paleti -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== ÜST KOYU KART ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dark_rounded_bottom"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="40dp"
            android:paddingBottom="36dp">

            <!-- Logo + Geri butonu satırı -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="20dp">

                <!-- Geri butonu -->
                <TextView
                    android:id="@+id/tvBack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="&#8592; Geri"
                    android:textColor="@color/auth_text_hint"
                    android:textSize="16sp" />

                <!-- Uygulama logosu -->
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/journal"
                    android:scaleType="fitCenter" />

            </LinearLayout>

            <!-- Avatar -->
            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_user_profile"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_avatar_circle"
                android:clipToOutline="true"
                android:outlineProvider="background"
                android:padding="0dp" />

            <!-- Kullanıcı adı -->
            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Kullanici Adi"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Email -->
            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="email@ornek.com"
                android:textColor="@color/auth_text_hint"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- ===== İSTATİSTİKLER KARTI ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp">

                <!-- Toplam günlük sayısı -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvJournalCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/auth_btn_primary"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_journals_count"
                        android:textColor="@color/brand_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Dikey ayırıcı -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#E9D5FF" />

                <!-- En sık ruh hali -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTopMood"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_no_mood"
                        android:textColor="@color/auth_btn_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_top_mood"
                        android:textColor="@color/brand_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== TREND GRAFİĞİ KARTI ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Son 7 Gün Duygu Trendi"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/auth_btn_primary"
                    android:layout_marginBottom="8dp" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/moodChart"
                    android:layout_width="match_parent"
                    android:layout_height="180dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== YARIN TAHMİNİ KARTI ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPrediction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#EDE9FE">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔮 Yarın İçin Tahmin"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/auth_btn_primary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvPrediction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.4"
                    android:textColor="@color/brand_text_secondary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== BUTONLAR ===== -->

        <!-- Avatar seç -->
        <Button
            android:id="@+id/btnChooseAvatar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_btn_auth_primary"
            android:text="@string/profile_choose_avatar"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <!-- ===== UYGULAMA KİLİDİ TOGGLE ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <!-- Yuvarlak mor kilit ikonu -->
                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="🔒"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:background="@drawable/bg_lock_icon_circle"
                    android:layout_marginEnd="14dp" />

                <!-- Başlık + açıklama -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Uygulama Kilidi"
                        android:textColor="@color/auth_btn_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Açılışta PIN kodu iste"
                        android:textColor="@color/brand_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <!-- Toggle switch -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchPinLock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/white"
                    app:trackTint="@color/auth_btn_primary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Şifre değiştir -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangePassword"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="10dp"
            android:text="@string/profile_change_password"
            android:textColor="@color/auth_btn_primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="50dp"
            app:strokeColor="@color/auth_btn_primary" />

        <!-- Hesabı sil -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteAccount"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="36dp"
            android:text="@string/profile_delete_account"
            android:textColor="#EF4444"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="50dp"
            app:strokeColor="#EF4444" />

    </LinearLayout>
</ScrollView>
